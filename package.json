{
  "name": "hive",
  "private": true,
  "version": "0.1.0",
  "description": "Hive — Fenced, verified agent coordination plane combining Vercel Board primitives and Buzz signed-event logs",
  "type": "module",
  "bin": {
    "hive": "./bin/hive.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --no-warnings --import tsx src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --no-warnings --import tsx --test tests/*.spec.ts",
    "hive": "node --no-warnings --import tsx src/cli/hive.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.79.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
